public class Question7 {
    public static void main(String[] args) {
        int[] numbers = {9, 5, 12, 6, 7, 1};
        System.out.println(findMaxInArray(numbers));
    }

    public static int findMaxInArray(int[] arr) {
        int max = arr[0];

        for (int i = 1; i < arr.length; i++) {
            if (arr[i] > max) {
                max = arr[i];
            }
        }

        return max;
    }
}
