public class Question5 {
    public static void main(String[] args) {
        int[] numbers = {1, 2, 3};
        System.out.println(calculateArraySum(numbers));
    }

    public static int calculateArraySum(int[] arr) {
        int sum = 0;

        for (int i = 0; i < arr.length; i++) {
            sum += arr[i];
        }

        return sum;
    }
}
