public class Question10 {
    public static void main(String[] args) {
        int[][] matrix = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}};

        System.out.println("Row with max sum is at index: " + findRowWithMaxSum(matrix));
    }

    public static int findRowWithMaxSum(int[][] arr) {
        if (arr.length == 0) {
            return -1;
        }

        int maxSum = calculateArraySum(arr[0]);
        int maxIndex = 0;

        for (int i = 1; i < arr.length; i++) {
            int sum = calculateArraySum(arr[i]);

            if (sum > maxSum) {
                maxSum = sum;
                maxIndex = i;
            }
        }

        return maxIndex;
    }

    public static int calculateArraySum(int[] arr) {
        int sum = 0;

        for (int i = 0; i < arr.length; i++) {
            sum += arr[i];
        }

        return sum;
    }
}
